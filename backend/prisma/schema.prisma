generator client {
  provider = "prisma-client-js"
}

generator dart {
  provider = "npx tsx scripts/generate-dart-models.ts"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  name                 String
  avatar               String?
  isAdmin              Boolean   @default(false)
  isBanned             Boolean   @default(false)
  passwordResetToken   String?
  passwordResetExpires DateTime?
  emailVerified        Boolean   @default(false)
  emailVerifyToken     String?   @unique
  emailVerifyExpires   DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  sessions             Session[]
  // AI: Add your app-specific relations below this line
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String   @unique
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // TMPL-6f: index the FK so "log out everywhere" / per-user session listing
  // (deleteMany/findMany by userId) don't table-scan as the Session table grows.
  @@index([userId])
}

